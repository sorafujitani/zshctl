{
  "product": "zshctl",
  "interfaceVersion": 1,
  "cliModes": [
    "pid", "chdir", "ghq-list", "snippet-list", "auto-snippet",
    "insert-snippet", "preprompt", "preprompt-snippet", "next-placeholder",
    "completion", "history-log",
    "history-query", "history-delete", "history-export", "history-import",
    "history-fzf-config", "server-run", "server-start", "server-stop",
    "server-restart", "server-status"
  ],
  "zsh": {
    "widgets": [
      "zshctl-auto-snippet", "zshctl-auto-snippet-and-accept-line",
      "zshctl-completion", "zshctl-ghq-cd", "zshctl-history-selection",
      "zshctl-insert-snippet", "zshctl-insert-space", "zshctl-preprompt",
      "zshctl-preprompt-snippet", "zshctl-smart-history-selection",
      "zshctl-snippet-next-placeholder", "zshctl-toggle-auto-snippet"
    ],
    "functions": [
      "zshctl-bind-default-keys", "zshctl-call-client-and-fallback",
      "zshctl-enable-sock", "zshctl-ensure-loaded", "zshctl-history-hooks",
      "zshctl-init", "zshctl-lazy-widget-dispatch", "zshctl-preload",
      "zshctl-preprompt-hooks", "zshctl-register-lazy-widget",
      "zshctl-register-lazy-widgets", "zshctl-run-lazy-fallback",
      "zshctl-server"
    ]
  },
  "environment": [
    "ZSHCTL_AUTO_SNIPPET_FALLBACK", "ZSHCTL_CLIENT_TIMEOUT_SECONDS",
    "ZSHCTL_COMPLETION_FALLBACK", "ZSHCTL_CONFIG",
    "ZSHCTL_DEFAULT_FZF_OPTIONS", "ZSHCTL_DISABLE_AUTOMATIC_WORKSPACE_LOOKUP",
    "ZSHCTL_DISABLE_BUILTIN_COMPLETION", "ZSHCTL_DISABLE_DAEMON",
    "ZSHCTL_DIRECT_FALLBACK", "ZSHCTL_ENABLE", "ZSHCTL_ENABLE_FZF_TMUX",
    "ZSHCTL_FZF_COMMAND", "ZSHCTL_FZF_TMUX_OPTIONS",
    "ZSHCTL_GHQ_CD_DIR", "ZSHCTL_GIT_CAT", "ZSHCTL_GIT_TREE",
    "ZSHCTL_HISTORY_LIMIT", "ZSHCTL_HISTORY_SESSION_ID", "ZSHCTL_HOME",
    "ZSHCTL_LOCAL_CONFIG_PATH", "ZSHCTL_PREPROMPT_BUFFER",
    "ZSHCTL_PREPROMPT_CURSOR", "ZSHCTL_PREPROMPT_RAW", "ZSHCTL_ROOT",
    "ZSHCTL_RUNTIME_DIR", "ZSHCTL_SESSION_ID", "ZSHCTL_SHELL"
  ],
  "config": {
    "fields": [
      "snippets[].name", "snippets[].keyword", "snippets[].snippet",
      "snippets[].context.global", "snippets[].context.buffer",
      "snippets[].context.lbuffer", "snippets[].context.rbuffer",
      "snippets[].evaluate", "completions[].name", "completions[].patterns",
      "completions[].excludePatterns", "completions[].sourceCommand",
      "completions[].preview", "completions[].callback",
      "completions[].callbackZero",
      "completions[].options", "history.defaultScope", "history.redact",
      "history.keymap.deleteSoft", "history.keymap.deleteHard",
      "history.keymap.toggleScope", "history.keymap.togglePreview",
      "history.fzfCommand", "history.fzfOptions"
    ]
  },
  "coverage": {
    "cliModes": "Rust unit tests and tests/daemon/lifecycle.sh",
    "zshWidgetsAndFunctions": "tests/zsh/smoke.zsh and tests/zsh/fallback.sh",
    "environment": "tests/config/cache.sh",
    "configFields": "zshctl-config unit tests and config integration tests",
    "gitCompletions": "spec/git-completions.json and tests/features/completion.sh",
    "history": "zshctl-history unit tests and tests/history/stress.sh"
  },
  "v1Exclusions": ["fish shell integration", "Fish YAML history import"]
}
