#autoload
emulate -L zsh
setopt typesetsilent

local root=${ZSHCTL_ROOT:-$PWD}
local client=zshctl
local scripts=$root/shells/zsh/scripts
local state_file=$(mktemp "${TMPDIR:-/tmp}/zshctl-history-state.XXXXXX") || return 1
print -r -- global >| "$state_file"
local limit=${ZSHCTL_HISTORY_LIMIT:-2000}
local session=${ZSHCTL_HISTORY_SESSION_ID:-$ZSHCTL_SESSION_ID}
local config_raw config_command config_options preview_key='?'
if config_raw=$(command "$client" history fzf-config 2>/dev/null); then
  local -a fields=("${(@ps:\0:)config_raw}")
  [[ ${fields[1]-} == success ]] && {
    config_command=${fields[2]-}
    config_options=${fields[3]-}
    preview_key=${fields[4]:-?}
  }
fi
local raw_command=${config_command:-${ZSHCTL_FZF_COMMAND:-}}
if [[ -z $raw_command ]]; then
  [[ -n ${TMUX-} ]] && raw_command=fzf-tmux || raw_command=fzf
fi
local -a fzf_command=(${(z)raw_command}) runtime_options=(${(z)config_options})
local scope_cmd=("$scripts/zshctl-smart-history-scope.sh" "$state_file" "$client" "$PWD" "$limit" "$session")
local toggle_cmd=("$scripts/zshctl-smart-history-toggle.sh" "$state_file")
local delete_cmd=("$scripts/zshctl-smart-history-delete.sh" "$client")
local scope_str=$(printf '%q ' "${scope_cmd[@]}"); scope_str=${scope_str% }
local toggle_str=$(printf '%q ' "${toggle_cmd[@]}"); toggle_str=${toggle_str% }
local delete_str=$(printf '%q ' "${delete_cmd[@]}"); delete_str=${delete_str% }; delete_str+=' {1}'
local preview='if [ "{1}" = "__empty__" ]; then printf "No entries\n"; else zshctl history query --format json --id {1} | tail -n +2; fi'
local -a opts=("${runtime_options[@]}" "--query=$LBUFFER" --nth=3 '--prompt=History> ' --with-nth=2..6 $'--delimiter=\u00a0' --ansi --no-multi --header-lines=1
  --bind "start:reload(:)+reload(${scope_str})"
  --bind "ctrl-r:execute-silent(${toggle_str})+reload(:)+reload(${scope_str})"
  --bind "ctrl-d:execute-silent(${delete_str})+reload(:)+reload(${scope_str})"
  --preview "$preview" --preview-window right)
[[ -n $preview_key ]] && opts+=(--bind "${preview_key}:toggle-preview")
local selection
selection=$(printf '' | "${fzf_command[@]}" "${opts[@]}")
local exit_code=$?
command rm -f -- "$state_file"
(( exit_code == 0 )) && [[ -n $selection ]] || { zle reset-prompt; return 0 }
local -a fields=("${(@ps:\u00a0:)selection}")
[[ ${fields[1]-} != __empty__ ]] || { zle reset-prompt; return 0 }
local command=${fields[7]:-${fields[4]-}}
command=${command//$'\x1f'/$'\t'}
[[ -n $command ]] && { BUFFER=$command; CURSOR=${#BUFFER} }
zle reset-prompt
