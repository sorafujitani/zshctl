#autoload
emulate -L zsh
local callback callback_kind callback_zero command_line options source_command
local fallback search_input leading raw_fzf_command snippet_options delimiter
local snippet_selected snippet_key
local -a out selected option_words candidate_out snippet_choices fzf_cmd fzf_options insert_out

fallback=${ZSHCTL_COMPLETION_FALLBACK:-expand-or-complete}
out=("${(f)$(command zshctl --mode=completion --input.lbuffer="$LBUFFER" --input.rbuffer="$RBUFFER")}")
if [[ $out[1] != success ]]; then
  if [[ $LBUFFER == *$'\n'* || $RBUFFER == *$'\n'* ]]; then
    zle "$fallback"
    return
  fi

  search_input=$LBUFFER
  leading=
  while [[ -n $search_input && ${search_input[1]} == [[:space:]] ]]; do
    leading+="${search_input[1]}"
    search_input=${search_input[2,-1]}
  done
  if [[ -z $search_input || -n $RBUFFER || $search_input == *[[:space:]]* ]]; then
    zle "$fallback"
    return
  fi

  candidate_out=("${(f)$(command zshctl --mode=snippet-candidates --input.lbuffer="$LBUFFER" --input.rbuffer="$RBUFFER")}")
  if [[ $candidate_out[1] != success ]]; then
    zle "$fallback"
    return
  fi
  snippet_options=${candidate_out[2]-}
  snippet_choices=("${candidate_out[@]}")
  shift 2 snippet_choices
  if (( ! ${#snippet_choices} )); then
    zle "$fallback"
    return
  fi

  raw_fzf_command=${ZSHCTL_FZF_COMMAND:-fzf}
  fzf_cmd=(${(Q)${(z)raw_fzf_command}})
  (( ${#fzf_cmd} )) || fzf_cmd=(fzf)
  fzf_options=(${(Q)${(z)snippet_options}})
  delimiter=$'\t'
  fzf_options+=("--delimiter=$delimiter" "--nth=.." "--with-nth=3")
  [[ -n $search_input ]] && fzf_options+=("--query=$search_input")
  snippet_selected=$(print -rl -- "${snippet_choices[@]}" | "${fzf_cmd[@]}" "${fzf_options[@]}") || { zle reset-prompt; return 0; }
  [[ -n $snippet_selected ]] || { zle reset-prompt; return 0; }

  snippet_key=${snippet_selected%%$'\t'*}
  [[ -n $snippet_key ]] || return 0
  insert_out=("${(f)$(command zshctl --mode=insert-snippet-id --input.snippet-id="$snippet_key" --input.lbuffer= --input.rbuffer= --input.context-lbuffer="$LBUFFER" --input.context-rbuffer="$RBUFFER")}")
  if [[ $insert_out[1] == success ]]; then
    BUFFER="${leading}${insert_out[2]}"
    CURSOR=$((${#leading} + insert_out[3]))
  fi
  zle reset-prompt
  return 0
fi
source_command=$out[2]
options=$out[3]
callback_kind=$out[-2]
if [[ $callback_kind == shell ]]; then
  if [[ $out[-3] == zero ]]; then
    callback_zero=1
    callback=$out[-4]
  else
    callback=$out[-3]
  fi
fi

option_words=(${(z)options})
command_line="$source_command | ${ZSHCTL_FZF_COMMAND:-fzf} ${(j: :)${(q)option_words}}"
selected=("${(0)$(eval "$command_line")}") || { zle reset-prompt; return 0; }
selected=(${(@)selected:#})
(( ${#selected} )) || { zle reset-prompt; return 0; }

if [[ $callback_kind == shell && -n $callback ]]; then
  if (( callback_zero )); then
    selected=("${(0)$(printf '%s\0' "${selected[@]}" | eval "$callback")}")
  else
    selected=("${(f)$(printf '%s\n' "${selected[@]}" | eval "$callback")}")
  fi
fi

selected=(${(@)selected:#})
if (( ${#selected} )); then
  LBUFFER+=${(@q)selected}
  zle zshctl-snippet-next-placeholder
fi
zle reset-prompt
