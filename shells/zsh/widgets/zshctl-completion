#autoload
emulate -L zsh
local callback callback_kind callback_zero command_line options source_command
local -a out selected option_words

out=("${(f)$(command zshctl --mode=completion --input.lbuffer="$LBUFFER" --input.rbuffer="$RBUFFER")}")
if [[ $out[1] != success ]]; then
  zle ${ZSHCTL_COMPLETION_FALLBACK:-expand-or-complete}
  return
fi
source_command=$out[2]
options=$out[3]
callback_kind=$out[-2]
if [[ $callback_kind == shell ]]; then
  if [[ $out[-3] == zero ]]; then
    callback_zero=1
    callback=$out[-4]
  else
    callback=$out[-3]
  fi
fi

option_words=(${(z)options})
command_line="$source_command | ${ZSHCTL_FZF_COMMAND:-fzf} ${(j: :)${(q)option_words}}"
selected=("${(0)$(eval "$command_line")}") || return 0
selected=(${(@)selected:#})
(( ${#selected} )) || return 0

if [[ $callback_kind == shell && -n $callback ]]; then
  if (( callback_zero )); then
    selected=("${(0)$(printf '%s\0' "${selected[@]}" | eval "$callback")}")
  else
    selected=("${(f)$(printf '%s\n' "${selected[@]}" | eval "$callback")}")
  fi
fi

selected=(${(@)selected:#})
if (( ${#selected} )); then
  LBUFFER+=${(@q)selected}
  zle zshctl-snippet-next-placeholder
fi
zle reset-prompt
