#autoload
emulate -L zsh
setopt typesetsilent

if [[ -z ${BUFFER+x} || -z ${LBUFFER+x} ]]; then
  print -u2 'zshctl-history-selection: must be invoked as a ZLE widget'
  return 1
fi

local raw_command=${ZSHCTL_FZF_COMMAND:-}
if [[ -z $raw_command ]]; then
  if [[ -n ${ZSHCTL_ENABLE_FZF_TMUX:-} && -n ${TMUX-} ]]; then
    raw_command=fzf-tmux
  else
    raw_command=fzf
  fi
fi
local -a fzf_cmd=(${(z)raw_command})
(( ${#fzf_cmd} )) || fzf_cmd=(fzf)
local -a fzf_args=(--no-sort --exact --no-multi "--query=$LBUFFER" '--prompt=History> ' --with-nth=2..)
if [[ $fzf_cmd[1] == fzf-tmux ]]; then
  local tmux_options=${ZSHCTL_FZF_TMUX_OPTIONS:-}
  [[ -n $tmux_options ]] && fzf_args=(${(z)tmux_options} "${fzf_args[@]}")
fi
if whence -p bat >/dev/null 2>&1; then
  local preview_cmd=$'echo {} | perl -pe "s/^[\\s\\t]*[0-9]*[\\s\\t]*//" | bat --color=always --language=sh --style=plain'
  fzf_args+=(--preview "$preview_cmd" --preview-window down)
fi

local selection
selection=$(builtin history -r 1 | "${fzf_cmd[@]}" "${fzf_args[@]}") || {
  zle reset-prompt
  return 0
}
selection=${selection%%$'\n'*}
[[ -n $selection ]] || { zle reset-prompt; return 0; }
local -a parts=(${=selection})
[[ -n ${parts[1]-} ]] || { zle reset-prompt; return 0; }
zle vi-fetch-history -n "${parts[1]}"
zle reset-prompt
